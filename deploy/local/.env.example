# Local development settings. Copy to .env and adjust. Placeholders only: never put real secrets here.
# Real dev secrets are fetched by scripts/dev-secrets.sh into ~/.config/sportify/ (outside the repo).

# --- PostgreSQL (docker compose, dev-only throwaway credentials) ---
POSTGRES_PASSWORD=dev-only-not-a-secret
ORCHESTRATOR_DATABASE_URL=postgresql+psycopg://orchestrator:dev-only-not-a-secret@localhost:5432/orchestrator

# --- Service-to-service auth (local mode uses a static dev token) ---
SPORTIFY_AUTH_MODE=static
SPORTIFY_DEV_SERVICE_TOKEN=dev-only-change-me

# --- Discovery ---
DISCOVERY_AZURE_MODE=mock            # mock | sdk  (sdk uses `az login` locally)
# Path is relative to the directory you start the service from (services/).
DISCOVERY_POLICY_FILE=../policies/allowlist.yaml
DISCOVERY_BASE_URL=http://localhost:8001

# --- Orchestrator ---
ORCHESTRATOR_GITHUB_MODE=mock        # mock | app
ORCHESTRATOR_GITHUB_ORG=sportify-org
ORCHESTRATOR_GITHUB_APP_ID=
ORCHESTRATOR_GITHUB_APP_INSTALLATION_ID=
ORCHESTRATOR_GITHUB_APP_PRIVATE_KEY_FILE=~/.config/sportify/gh-app-orchestrator-key.pem
ORCHESTRATOR_GITHUB_WEBHOOK_SECRET_FILE=~/.config/sportify/gh-app-orchestrator-webhook-secret
ORCHESTRATOR_PLATFORM_REPO=sportify-azure-backstage
ORCHESTRATOR_BACKSTAGE_BASE_URL=http://localhost:7007
ORCHESTRATOR_CALLBACK_AUDIENCE=sportify-orchestrator

# --- Backstage ---
GITHUB_APP_BACKSTAGE_CREDENTIALS_FILE=~/.config/sportify/gh-app-backstage.yaml
