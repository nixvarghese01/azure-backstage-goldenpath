name: application-ci
run-name: "ci ${{ vars.IDP_REQUEST_ID }} ${{ github.head_ref || github.ref_name }}"

on:
  pull_request:
  push:
    branches: [main]

permissions:
  contents: read

jobs:
  ci:
    uses: [[ values.org ]]/azure-backstage-goldenpath/.github/workflows/reusable-application-ci.yml@[[ values.platform_ref ]]
    permissions:
      contents: read
      id-token: write          # push job: Azure federation and provenance signing
      actions: read            # CodeQL
      security-events: write   # CodeQL results
      attestations: write      # build provenance
    with:
      environment: [[ values.environment ]]
      image_name: [[ values.app ]]
