# [[ values.app ]] / FastAPI. No tooling is installed into the runtime image.
FROM python:3.14-slim AS build
WORKDIR /src
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY app ./app
COPY tests ./tests
COPY requirements-dev.txt .

FROM build AS verify
RUN pip install --no-cache-dir -r requirements-dev.txt
RUN ruff check app tests && python -m pytest tests -q

FROM python:3.14-slim AS runtime
# pip is not needed at runtime, and its vendored certifi lags behind (GHSA-6q48-6c7w-9gw2).
RUN pip uninstall --yes pip \n    && groupadd --gid 10001 app && useradd --uid 10001 --gid app --no-create-home app
WORKDIR /app
COPY --from=build /opt/venv /opt/venv
COPY --from=build /src/app ./app
ENV PATH="/opt/venv/bin:$PATH" PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
USER 10001
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:3000/health/ready',timeout=3)"
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "3000"]
