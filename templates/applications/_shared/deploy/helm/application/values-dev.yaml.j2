# Generated by the platform from the provisioned infrastructure (request [[ values.request_id ]]).
# Identifiers only - no secrets.

image:
  repository: [[ values.outputs.get("acr_login_server", values.resolved.get("container_registry_login_server", "")) ]]/[[ values.app ]]
  tag: latest   # overridden with the commit SHA at deploy time

availability:
  tier: [[ values.availability.get("tier", "standard") ]]

# Runtime profile for the [[ values.stack | default("nestjs") ]] stack: one pod with the minimum resources it needs.
# The ha tier scales this same pod size with the HPA. Change both numbers together with docker-compose.yml.
replicaCount: 1
resources:
  requests:
    cpu: [[ values.profile.cpu_request ]]
    memory: [[ values.profile.memory ]]
  limits:
    cpu: [[ values.profile.cpu_limit ]]
    memory: [[ values.profile.memory ]]
probes:
  startup:
    failureThreshold: [[ values.profile.startup_failure_threshold ]]
[%- if values.profile.env %]
env:
[%- for name, value in values.profile.env.items() %]
  [[ name ]]: "[[ value ]]"
[%- endfor %]
[%- endif %]

serviceAccount:
  name: [[ values.app ]]
  workloadIdentityClientId: "[[ values.outputs.get("identity_client_id", "") ]]"

route:
  enabled: true
  host: [[ values.endpoint_host ]]

azure:
  storageAccountName: "[[ values.outputs.get("storage_account_name") or "" ]]"
  blobContainer: [% if values.runtime_capability.get("mode") == "existing" %]shared[% else %]app-data[% endif %]
  keyVaultUri: "[[ values.outputs.get("key_vault_uri") or "" ]]"
