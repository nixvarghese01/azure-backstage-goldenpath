name: application-ci
run-name: "ci ${{ vars.SPORTIFY_REQUEST_ID }} ${{ github.head_ref || github.ref_name }}"
on:
  pull_request:
  push:
    branches: [main]
permissions:
  contents: read
jobs:
  ci:
    uses: [[ values.org ]]/sportify-azure-backstage/.github/workflows/reusable-application-ci.yml@main
    permissions:
      contents: read
      id-token: write          # push job: Azure federation and provenance signing
      actions: read            # CodeQL
      security-events: write   # CodeQL results
      attestations: write      # build provenance
    with:
      environment: [[ values.environment ]]
      image_name: [[ values.app ]]
      runtime: [[ {"fastapi": "python", "go": "go", "dotnet": "dotnet", "springboot": "java"}.get(values.stack | default("nestjs"), "node") ]]
